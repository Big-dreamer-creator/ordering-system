.page {
  padding: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  color: #666666;
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 40rpx;
}
