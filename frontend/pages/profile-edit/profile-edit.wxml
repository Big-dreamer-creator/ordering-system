<view class="page">
  <view class="card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        placeholder="请输入昵称"
        maxlength="50"
      />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        value="{{phone}}"
        bindinput="onPhoneInput"
        placeholder="请输入手机号"
        maxlength="20"
      />
    </view>
  </view>

  <button
    class="btn-primary save-btn"
    bindtap="onSave"
    disabled="{{saving}}"
  >{{saving ? '保存中...' : '保存'}}</button>
</view>
