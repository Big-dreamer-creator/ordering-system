.page {
  padding: 20rpx;
}

.status-card {
  text-align: center;
  padding: 40rpx 24rpx;
}

.status-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #e64a19;
}

.status-tip {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.item-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.item-name {
  font-size: 28rpx;
}

.item-price {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.item-subtotal {
  font-size: 28rpx;
  color: #e64a19;
}

.total-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 28rpx;
}

.total-line .price {
  font-size: 36rpx;
}

.info-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.info-label {
  color: #999999;
}

.info-value {
  max-width: 460rpx;
  text-align: right;
  word-break: break-all;
}

.cancel-btn {
  margin-top: 20rpx;
}
