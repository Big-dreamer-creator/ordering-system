.page {
  padding: 20rpx;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #e64a19;
  color: #ffffff;
  font-size: 52rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
}

.user-phone {
  font-size: 26rpx;
  color: #999999;
  margin-top: 10rpx;
}

.edit-btn {
  padding: 10rpx 28rpx;
  border: 1rpx solid #e64a19;
  border-radius: 32rpx;
  color: #e64a19;
  font-size: 26rpx;
}

.stats-card {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f0f0f0;
}

.stat:last-child {
  border-right: none;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #e64a19;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.link {
  text-align: center;
  color: #e64a19;
  font-size: 28rpx;
}

.logout {
  color: #999999;
}
