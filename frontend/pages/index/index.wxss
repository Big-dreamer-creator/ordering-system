.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 16rpx 20rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background-color: #f2f2f2;
  border-radius: 32rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  background-color: #e64a19;
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 28rpx;
}

.category-bar {
  white-space: nowrap;
  background-color: #ffffff;
  padding: 16rpx 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  background-color: #f2f2f2;
  color: #666666;
  font-size: 28rpx;
}

.category-item.active {
  background-color: #e64a19;
  color: #ffffff;
}

.dish-list {
  padding: 20rpx;
}

.dish-item {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.dish-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #ffe0d6;
  color: #e64a19;
  font-size: 48rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.dish-name {
  font-size: 32rpx;
  font-weight: bold;
}

.dish-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.dish-bottom .price {
  font-size: 34rpx;
}

.add-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background-color: #e64a19;
  color: #ffffff;
  font-size: 40rpx;
}
