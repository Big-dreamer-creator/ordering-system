<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索菜品名称"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      bindconfirm="onSearch"
      confirm-type="search"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <scroll-view class="category-bar" scroll-x="true">
    <view
      class="category-item {{activeCategory === '' ? 'active' : ''}}"
      bindtap="onSelectCategory"
      data-category=""
    >全部</view>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="category-item {{activeCategory === item ? 'active' : ''}}"
      bindtap="onSelectCategory"
      data-category="{{item}}"
    >{{item}}</view>
  </scroll-view>

  <view class="dish-list">
    <view class="dish-item" wx:for="{{dishes}}" wx:key="id">
      <view class="dish-thumb">{{item.initial}}</view>
      <view class="dish-info">
        <view class="dish-name">{{item.name}}</view>
        <view class="dish-desc">{{item.description}}</view>
        <view class="dish-bottom">
          <text class="price">¥{{item.priceText}}</text>
          <view class="add-btn" bindtap="onAddToCart" data-dish="{{item}}">+</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{loading}}">加载中...</view>
    <view class="empty" wx:elif="{{dishes.length === 0}}">暂无菜品</view>
  </view>
</view>
