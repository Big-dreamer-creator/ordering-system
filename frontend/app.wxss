/* 全局样式 */
page {
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
}

.container {
  padding: 24rpx;
}

/* 按钮 */
.btn-primary {
  background-color: #e64a19;
  color: #ffffff;
  border-radius: 40rpx;
}

.btn-primary[disabled] {
  background-color: #f0b9a8;
  color: #ffffff;
}

.btn-plain {
  background-color: #ffffff;
  color: #e64a19;
  border: 1rpx solid #e64a19;
  border-radius: 40rpx;
}

/* 空状态 */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}

/* 卡片 */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* 价格 */
.price {
  color: #e64a19;
  font-weight: bold;
}
